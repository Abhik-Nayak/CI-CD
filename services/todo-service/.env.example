# todo-service environment — copy to .env and fill in real values.
# In Docker/Compose these are injected via env_file.

PORT=5001

# PostgreSQL connection (shared Aurora cluster; todo-service owns the todos table).
DB_HOST=your-cluster.xxxxxx.<region>.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASS=your-db-password
DB_NAME=devdb
DB_SSL=true

# Verifies tokens issued by auth-service. MUST be identical to auth-service's JWT_SECRET.
JWT_SECRET=change-me-to-a-long-random-string
