# auth-service environment — copy to .env and fill in real values.
# In Docker/Compose these are injected via env_file.

PORT=5002

# PostgreSQL connection (shared Aurora cluster; auth-service owns the users table).
DB_HOST=your-cluster.xxxxxx.<region>.rds.amazonaws.com
DB_PORT=5432
DB_USER=postgres
DB_PASS=your-db-password
DB_NAME=devdb
DB_SSL=true

# Signs the auth tokens. MUST be identical to todo-service's JWT_SECRET so it can verify them.
JWT_SECRET=change-me-to-a-long-random-string
