# Copy to .env for local (non-Docker) runs:  cp .env.example .env
# In Docker/Compose these are injected by the orchestrator instead.

PORT=4001

# When running the service WITHOUT Docker, Postgres is on localhost.
# Inside Docker Compose, DB_HOST becomes the postgres service name (Phase 2).
DB_HOST=localhost
DB_PORT=5432
DB_USER=auth
DB_PASSWORD=auth
DB_NAME=auth

# CHANGE THESE in any real environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
